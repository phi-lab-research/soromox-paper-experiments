# Keep trained model checkpoints out of normal Git object history.
paper_results/secVg_parallel_rl/data/checkpoints/* filter=lfs diff=lfs merge=lfs -text
# Keep rendered Section Vg media out of normal Git object history.
paper_results/secVg_parallel_rl/outputs/*.mp4 filter=lfs diff=lfs merge=lfs -text
paper_results/secVg_parallel_rl/outputs/*.gif filter=lfs diff=lfs merge=lfs -text
# Keep Section Vd rollout archives and rendered media out of normal Git object history.
paper_results/secVd_control_gain_optimization/data/*/optimization_results.npz filter=lfs diff=lfs merge=lfs -text
paper_results/secVd_control_gain_optimization/outputs/*.mp4 filter=lfs diff=lfs merge=lfs -text
paper_results/secVd_control_gain_optimization/outputs/*.gif filter=lfs diff=lfs merge=lfs -text

# Keep rendered Section Vf media out of normal Git object history.
paper_results/secVf_sampling_based_mpc/outputs/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
paper_results/secVf_sampling_based_mpc/outputs/**/*.gif filter=lfs diff=lfs merge=lfs -text

# Unified patches use a leading space for blank context lines.
third_party/open3d/*.patch whitespace=-blank-at-eol
# Keep the Section Vf full-sample run (every candidate rollout) out of normal Git object history.
paper_results/secVf_sampling_based_mpc/data/square_icem_seed0.npz filter=lfs diff=lfs merge=lfs -text
